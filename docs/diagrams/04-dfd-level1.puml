@startuml
left to right direction
actor "Inventory Manager" as IM
actor Cashier
actor "Hotel Manager" as HM
rectangle "1.0 Catalog & Supplier Management" as P1
rectangle "2.0 Inventory Control" as P2
rectangle "3.0 POS & Checkout" as P3
rectangle "4.0 Invoice & Payment" as P4
rectangle "5.0 Reporting" as P5
database "D1 Products / Categories" as D1
database "D2 Suppliers" as D2
database "D3 Stock Movements" as D3
database "D4 Sales / Sale Items" as D4
database "D5 Payments" as D5
IM --> P1 : product and supplier details
P1 --> D1 : product/category records
P1 --> D2 : supplier records
IM --> P2 : stock receipt / issue / count
P2 --> D1 : update on-hand quantity
P2 --> D3 : movement ledger
Cashier --> P3 : cart and customer data
P3 --> D1 : read product and stock
P3 --> D4 : sale header and lines
P3 --> D3 : POS stock-out entries
P3 --> P4 : sale totals and initial payment
P4 --> D5 : payment records
P4 --> D4 : paid amount and balance/status
HM --> P5 : report period/request
D1 --> P5 : product and stock values
D2 --> P5 : supplier details
D3 --> P5 : movement history
D4 --> P5 : sales data
D5 --> P5 : payment data
P5 --> HM : sales and inventory reports
@enduml
